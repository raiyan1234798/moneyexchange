# Firebase WEB config — public by design (these values ship in the client
# bundle for every visitor; security is enforced by Firestore rules, not by
# hiding these). Committed so Cloudflare Pages Git builds work without any
# dashboard environment-variable setup.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=moneyexchange-35c33
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB4rdpTTYMkANCaLB3TAZY6uYrJBer99zQ
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=moneyexchange-35c33.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=moneyexchange-35c33.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=637211805598
NEXT_PUBLIC_FIREBASE_APP_ID=1:637211805598:web:65a34dee785b19cc89b88f
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-D0ZTXRVPYK
NEXT_PUBLIC_SITE_URL=https://unimoni.pages.dev

# Uploads go to Cloudflare R2 via the same-origin Pages Worker (web/public/_worker.js).
# Requires the R2_BUCKET binding on the Pages project; if unbound, uploads fall
# back to Firestore automatically (no breakage).
NEXT_PUBLIC_R2_UPLOAD_URL=/api/upload
