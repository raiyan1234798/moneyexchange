# Copy values into Cloudflare Pages → unimoni → Settings → Environment variables
# (Production and Preview). Rebuild after saving.
#
# Firebase Console → Project settings → Your apps → Web app config

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=moneyexchange-35c33.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=moneyexchange-35c33
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=moneyexchange-35c33.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional — enable file uploads via Cloudflare R2 (see scripts/R2-SETUP.md)
NEXT_PUBLIC_R2_UPLOAD_URL=
