rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function authEmailLower() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        ? request.auth.token.email.lower()
        : '';
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return exists(userDocPath());
    }

    function userDoc() {
      return get(userDocPath()).data;
    }

    function isActiveUser() {
      return isAuthenticated() && userDocExists() && userDoc().isActive == true;
    }

    function isSuperAdmin() {
      return isActiveUser() && (
        userDoc().role == 'superAdmin' ||
        authEmailLower() == 'abubackerraiyan@gmail.com'
      );
    }

    function isAdmin() {
      return isActiveUser() && userDoc().role == 'admin';
    }

    function isBranchManager() {
      return isActiveUser() && userDoc().role == 'branchManager';
    }

    function isBranchUser() {
      return isActiveUser() && userDoc().role == 'branchUser';
    }

    function managerBranchId() {
      return userDoc().branchId;
    }

    function belongsToManagerBranch(branchId) {
      return isBranchManager() && managerBranchId() == branchId;
    }

    function belongsToBranchUserBranch(branchId) {
      return isBranchUser() && managerBranchId() == branchId;
    }

    function canAccessBranch(branchId) {
      return isSuperAdmin() || isAdmin() || belongsToManagerBranch(branchId) || belongsToBranchUserBranch(branchId);
    }

    function canManageBranchContent(branchId) {
      return isSuperAdmin() || isAdmin() || belongsToManagerBranch(branchId);
    }

    // "Access" chips from the Users page — a granted module key unlocks that
    // feature for ANY role (client 2026-08-01: the grid must actually work).
    function hasModuleKey(k) {
      return isActiveUser() && 'moduleAccess' in userDoc() &&
        userDoc().moduleAccess.hasAny([k]);
    }

    function canManageBranchRates(branchId) {
      return isSuperAdmin() || belongsToManagerBranch(branchId) || belongsToBranchUserBranch(branchId);
    }

    function hasOnlyAllowedKeys(allowedKeys) {
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    function validRoles() {
      return ['superAdmin', 'admin', 'branchManager', 'branchUser'];
    }

    function isValidUserCreate() {
      let data = request.resource.data;
      return hasOnlyAllowedKeys([
        'email', 'displayName', 'role', 'branchId', 'photoURL',
        'isActive', 'createdAt', 'updatedAt', 'lastLoginAt', 'moduleAccess'
      ])
      && data.email is string
      && data.displayName is string
      && data.role in validRoles()
      && data.isActive is bool;
    }

    function isValidUserUpdate() {
      let data = request.resource.data;
      return hasOnlyAllowedKeys([
        'email', 'displayName', 'role', 'branchId', 'photoURL',
        'isActive', 'createdAt', 'updatedAt', 'lastLoginAt', 'moduleAccess'
      ])
      && data.email is string
      && data.displayName is string
      && data.role in validRoles()
      && data.isActive is bool;
    }

    function isSuperAdminEmail() {
      return isAuthenticated() && authEmailLower() == 'abubackerraiyan@gmail.com';
    }

    function inviteDocPath(inviteEmail) {
      return /databases/$(database)/documents/user_invites/$(inviteEmail);
    }

    function inviteData(inviteEmail) {
      return get(inviteDocPath(inviteEmail)).data;
    }

    function branchExists(branchId) {
      return branchId != null
        && branchId != ''
        && exists(/databases/$(database)/documents/branches/$(branchId));
    }

    function inviteRole(inviteEmail) {
      let invite = inviteData(inviteEmail);
      return invite.keys().hasAny(['role']) && invite.role != null
        ? invite.role
        : 'branchManager';
    }

    function inviteBranchId(inviteEmail) {
      let invite = inviteData(inviteEmail);
      let role = inviteRole(inviteEmail);
      return role == 'admin'
        ? null
        : (invite.keys().hasAny(['branchId']) && invite.branchId != null && invite.branchId != ''
            ? invite.branchId
            : null);
    }

    function normalizedBranchId(branchId) {
      return branchId != null && branchId != '' ? branchId : null;
    }

    function branchIdsMatch(profileBranchId, inviteEmail) {
      return normalizedBranchId(profileBranchId) == inviteBranchId(inviteEmail);
    }

    function inviteIsOpen(inviteEmail) {
      let invite = inviteData(inviteEmail);
      return !invite.keys().hasAny(['status'])
        || invite.status == 'pending'
        || invite.status == 'approved';
    }

    function hasInviteForAuthEmail() {
      let email = authEmailLower();
      return email != '' && exists(inviteDocPath(email));
    }

    function canManageInvite() {
      return isSuperAdmin() || isAdmin() ||
        (isBranchManager() &&
          resource != null &&
          resource.data.branchId == managerBranchId());
    }

    match /users/{userId} {
      // Defined INSIDE this match block: rules functions can only access
      // match variables (userId) from the scope where they are DEFINED.
      // At the top level, `userId` fails to resolve, the condition errors,
      // and every invited-user profile create is denied.
      function hasValidPendingInvite() {
        let email = authEmailLower();
        let data = request.resource.data;
        let role = inviteRole(email);
        return isAuthenticated()
          && request.auth.uid == userId
          && !exists(/databases/$(database)/documents/users/$(userId))
          && hasInviteForAuthEmail()
          && inviteIsOpen(email)
          && data.email.lower() == email
          && data.displayName is string
          && data.isActive == true
          && data.role == role
          && role in ['admin', 'branchManager', 'branchUser']
          && (role == 'admin'
            || (data.branchId is string
              && data.branchId != ''
              && branchExists(data.branchId)
              && branchIdsMatch(data.branchId, email)));
      }

      function isSuperAdminBootstrap() {
        let data = request.resource.data;
        return request.auth.uid == userId
          && isSuperAdminEmail()
          && data.email.lower() == 'abubackerraiyan@gmail.com'
          && data.role == 'superAdmin'
          && data.isActive == true
          && data.displayName is string;
      }

      // The client's password admin account (unique email, password-protected)
      // self-provisions an 'admin' profile on first sign-in. The email is unique
      // in Firebase Auth and can only be held by that account, so possession of
      // a token for it proves ownership.
      function isClientAdminBootstrap() {
        let data = request.resource.data;
        return request.auth.uid == userId
          && request.auth.token.email != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() == 'admin@unimoni-signage.com'
          && data.email.lower() == 'admin@unimoni-signage.com'
          && data.role == 'admin'
          && data.isActive == true
          && data.displayName is string;
      }

      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isAdmin() ||
        (isBranchManager() && resource.data.branchId == managerBranchId())
      );
      allow list: if isSuperAdmin() || isAdmin() || (isBranchManager() && resource.data.branchId == managerBranchId());
      allow create: if (isSuperAdmin() && isValidUserCreate()) ||
        // Admins may provision staff logins (email+password accounts created
        // client-side) — any role except superAdmin.
        (isAdmin() && isValidUserCreate() && request.resource.data.role != 'superAdmin') ||
        hasValidPendingInvite() ||
        isSuperAdminBootstrap() ||
        isClientAdminBootstrap();
      allow update: if (isSuperAdmin() && isValidUserUpdate()) ||
        (isAdmin() && isValidUserUpdate()
          && resource.data.role != 'superAdmin'
          && request.resource.data.role != 'superAdmin') ||
        // "Users" module chip: manage branch staff ONLY. It can flip isActive,
        // rename, or move a branch-staff member — but can NEVER change role or
        // moduleAccess (no privilege escalation), never target admins, and never
        // edit its OWN row (self-escalation guard). role + moduleAccess are
        // pinned to their prior values so a chip holder cannot grant modules.
        (hasModuleKey('users') && isValidUserUpdate()
          && request.auth.uid != userId
          && resource.data.role in ['branchManager', 'branchUser']
          // Own branch only, and cannot move the user to another branch — a chip
          // holder manages ONLY their own branch's staff (parity with invites).
          && resource.data.branchId == managerBranchId()
          && request.resource.data.branchId == resource.data.branchId
          && request.resource.data.role == resource.data.role
          && request.resource.data.moduleAccess == resource.data.moduleAccess
          && request.resource.data.email == resource.data.email) ||
        (request.auth.uid == userId && request.resource.data.diff(resource.data).changedKeys().hasOnly(['lastLoginAt', 'updatedAt', 'displayName', 'photoURL'])) ||
        (request.auth.uid == userId && isSuperAdminEmail() && isValidUserUpdate());
      // Permanent removal is limited to the OWNER admins (the same two accounts
      // that hold the password vault) — and nobody can delete the superAdmin.
      allow delete: if isSuperAdmin() ||
        (isAdmin()
          && resource.data.role != 'superAdmin'
          && (authEmailLower() == 'admin@unimoni-signage.com'
            || authEmailLower() == 'mohamedaalthaf@gmail.com'));
    }

    match /user_invites/{inviteEmail} {
      // Inside the match block so `inviteEmail` resolves (see note on /users).
      function canReadOwnInvite() {
        return isAuthenticated() && authEmailLower() != '' && (
          inviteEmail.lower() == authEmailLower() ||
          (resource != null && resource.data.keys().hasAny(['email']) &&
            resource.data.email.lower() == authEmailLower())
        );
      }

      allow read: if canManageInvite() || canReadOwnInvite();
      allow create: if isSuperAdmin() || isAdmin() ||
        // "Users" module chip: invite branch staff INTO THE CALLER'S OWN branch
        // only (never admins, never other branches).
        (hasModuleKey('users') &&
          request.resource.data.role in ['branchManager', 'branchUser'] &&
          request.resource.data.branchId == managerBranchId()) ||
        (isBranchManager() &&
          request.resource.data.role == 'branchUser' &&
          request.resource.data.branchId == managerBranchId());
      allow update: if isSuperAdmin() || isAdmin() ||
        (isBranchManager() &&
          resource.data.branchId == managerBranchId() &&
          request.resource.data.role == 'branchUser' &&
          request.resource.data.branchId == managerBranchId()) ||
        (canReadOwnInvite() &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isSuperAdmin() || isAdmin() ||
        // chip holders delete invites only in their own branch
        (hasModuleKey('users') && resource.data.branchId == managerBranchId()) ||
        canManageInvite() || canReadOwnInvite();
    }

    // Sign-in passwords the OWNER admins hand out to the team. Strictly limited
    // to the two owner accounts (plus the developer super admin) — no other
    // admin, manager, or user can even read these docs.
    match /user_credentials/{credEmail} {
      function isCredentialOwner() {
        return isAuthenticated() && (
          authEmailLower() == 'admin@unimoni-signage.com' ||
          authEmailLower() == 'mohamedaalthaf@gmail.com' ||
          isSuperAdminEmail()
        );
      }
      allow read, create, update, delete: if isCredentialOwner();
    }

    match /branches/{branchId} {
      allow get: if resource.data.status == 'active' ||
        (isActiveUser() && (isSuperAdmin() || isAdmin() || canAccessBranch(branchId)));
      allow list: if resource.data.status == 'active' ||
        (isActiveUser() && (isSuperAdmin() || isAdmin() || isBranchManager() || isBranchUser()));
      // Admins can create, update and delete branches (client request 2026-07-15).
      allow create: if isSuperAdmin() || isAdmin();
      allow delete: if isSuperAdmin() || isAdmin();
      // Rate staff may update ONLY settings.rateCardNote on a branch they can
      // access (Excel / Exchange Rates small-bills note) — never other settings.
      function onlyRateCardNoteChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['settings', 'updatedAt'])
          && (
            (!('settings' in resource.data)
              && request.resource.data.settings.keys().hasOnly(['rateCardNote']))
            || ('settings' in resource.data
              && request.resource.data.settings.diff(resource.data.settings)
                .affectedKeys().hasOnly(['rateCardNote']))
          );
      }
      function canEditRateCardNote() {
        return canAccessBranch(branchId) && (
          belongsToManagerBranch(branchId) ||
          belongsToBranchUserBranch(branchId) ||
          hasModuleKey('forexRatesAllBranches')
        );
      }
      // "Branches" module = full branch editing, but ONLY on a branch the user
      // belongs to (never every branch). The display-settings chips (settings /
      // promotions / display messages) may write ONLY the settings map (+ logo/
      // colour) — never code, name or status — again only on their own branch.
      allow update: if isSuperAdmin() || isAdmin() ||
        (hasModuleKey('branches') && canAccessBranch(branchId)) ||
        ((hasModuleKey('settings') || hasModuleKey('promotions') || hasModuleKey('displayMessages')) &&
          canAccessBranch(branchId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['settings', 'updatedAt', 'logoUrl', 'brandingColor'])) ||
        (canEditRateCardNote() && onlyRateCardNoteChanged());
    }

    // Small per-branch TV prefs (hidden remittance codes, etc.) — kept outside
    // the branch doc so writes succeed when branch.settings nears 1 MiB.
    match /branch_display_prefs/{branchId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin() ||
        hasModuleKey('forexRatesAllBranches') ||
        hasModuleKey('transferRates');
    }

    match /currencies/{currencyId} {
      allow read: if isActiveUser();
      // Admins manage the currency catalog too (client request 2026-07-20).
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    // Admin edits to how a currency LOOKS (flag emoji, name, country). Publicly
    // readable because the TV display loads them without signing in.
    match /currency_overrides/{code} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /exchange_rates/{rateId} {
      allow read: if isActiveUser() || resource.data.status == 'published';
      // "Forex rates — ALL branches" module: full rate editing on any branch.
      function hasAllBranchForex() {
        return isActiveUser() && 'moduleAccess' in userDoc() &&
          userDoc().moduleAccess.hasAny(['forexRatesAllBranches']);
      }
      // Opt-in module: add NEW currency rows to a branch (Excel & UI). Admins
      // always can; branch staff need this checkbox in Users.
      function hasAddBranchCurrencies() {
        return isActiveUser() && 'moduleAccess' in userDoc() &&
          userDoc().moduleAccess.hasAny(['addBranchCurrencies']);
      }
      // Admins manage rates across ALL branches; managers their own branch.
      // Branch users may ONLY edit + republish the forex VALUES of existing
      // rows in their branch — never rename, reorder, hide, transfer fields,
      // or create/delete rows unless granted addBranchCurrencies.
      allow create: if isSuperAdmin() || isAdmin() || hasAllBranchForex() ||
        (belongsToManagerBranch(request.resource.data.branchId) && hasAddBranchCurrencies()) ||
        (belongsToBranchUserBranch(request.resource.data.branchId) && hasAddBranchCurrencies());
      allow update: if isSuperAdmin() || isAdmin() || hasAllBranchForex() ||
        // Manager edits a row in THEIR OWN branch (check the EXISTING doc's
        // branch, not the incoming one) and cannot move the row to a branch —
        // otherwise a manager could hijack another branch's rate row by
        // rewriting its branchId to their own.
        (belongsToManagerBranch(resource.data.branchId) &&
          request.resource.data.branchId == resource.data.branchId) ||
        (belongsToBranchUserBranch(resource.data.branchId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['buyRate', 'sellRate', 'version', 'status', 'updatedBy', 'updatedByName',
             'publishedAt', 'updatedAt']));
      // Deleting a currency ROW is an admin-level action (client 2026-08-01:
      // "no user can delete any currency … only admins, and admin-chosen
      // users, can"). Neither branch managers nor branch users may delete —
      // they only edit values. Admins always; anyone else strictly needs the
      // "Add new currencies" grant (addBranchCurrencies), the same chip that
      // governs a currency's existence for create.
      allow delete: if isSuperAdmin() || isAdmin() || hasAddBranchCurrencies();
    }

    // Centralized money-transfer rates (head office): one set for ALL branches.
    // Public read (the TV display is unauthenticated); admin-only writes.
    match /transfer_rates/{code} {
      allow read: if true;
      // EDITING transfer values: admins always; branch managers by default
      // (client 2026-07-21); anyone else only when granted the "transferRates"
      // module in Users.
      allow create, update: if isSuperAdmin() || isAdmin() ||
        (isBranchManager() &&
          (!('moduleAccess' in userDoc()) ||
            userDoc().moduleAccess.hasAny(['transferRates']))) ||
        (isActiveUser() && 'moduleAccess' in userDoc() &&
          userDoc().moduleAccess.hasAny(['transferRates']));
      // DELETING a transfer currency is admin-level (client 2026-08-01): admins
      // always, otherwise only the admin-granted "Add new currencies" chip —
      // NOT the transferRates edit chip, and not branch managers by default.
      allow delete: if isSuperAdmin() || isAdmin() ||
        hasModuleKey('addBranchCurrencies');
    }

    match /rate_history/{historyId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if isSuperAdmin();
    }

    // Per client (2026-07-11): advert videos/images, playlists, and scrolling
    // messages are ADMIN-ONLY. Branch managers/users can view, never write.
    match /videos/{videoId} {
      allow read: if isActiveUser() || resource.data.status == 'active';
      // Admins, plus anyone granted the "media" module in Users.
      allow create, update, delete: if isSuperAdmin() || isAdmin() ||
        (isActiveUser() && 'moduleAccess' in userDoc() &&
          userDoc().moduleAccess.hasAny(['media']));
    }

    match /image_adverts/{imageId} {
      allow read: if isActiveUser() || resource.data.status == 'active';
      // Admins, plus anyone granted the "media" module in Users.
      allow create, update, delete: if isSuperAdmin() || isAdmin() ||
        (isActiveUser() && 'moduleAccess' in userDoc() &&
          userDoc().moduleAccess.hasAny(['media']));
    }

    match /video_chunks/{videoId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();

      match /parts/{partId} {
        allow read: if true;
        allow create, update, delete: if isSuperAdmin() || isAdmin();
      }
    }

    match /video_playlists/{playlistId} {
      allow read: if isActiveUser() || resource.data.status == 'active';
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /ticker_messages/{tickerId} {
      allow read: if isActiveUser() || resource.data.status == 'active';
      // Admins, plus anyone granted the "Display messages" module in Users.
      allow create, update, delete: if isSuperAdmin() || isAdmin() ||
        hasModuleKey('displayMessages');
    }

    match /tv_devices/{deviceId} {
      // A TV reads its OWN device doc by id (the id is its secret token). LISTING
      // the whole collection is staff-only — otherwise anyone could enumerate
      // every device's secret token and impersonate/hijack a TV.
      allow get: if true;
      allow list: if isActiveUser();
      // Two creators: (a) the unauthenticated TV self-registering — its doc id
      // MUST equal its deviceToken so it can't be spoofed under a chosen id;
      // (b) authenticated staff adding a device from the dashboard (auto-id),
      // scoped to a branch they manage.
      allow create: if request.resource.data.deviceToken == deviceId ||
        canManageBranchContent(request.resource.data.branchId);
      // Heartbeats/status may update, but the device's BRANCH can never be
      // repointed by an update — that was the TV-hijack vector.
      allow update: if (isActiveUser() || request.auth == null) &&
        request.resource.data.branchId == resource.data.branchId;
      allow delete: if isSuperAdmin() ||
        (isBranchManager() && canAccessBranch(resource.data.branchId));
    }

    match /tv_pairing_codes/{code} {
      allow get: if true;
      // Only branch content managers (or admins) mint/rotate/clear pairing codes
      // for their branch — not every signed-in user.
      allow create, update: if isSuperAdmin() || isAdmin() ||
        (isBranchManager() && canAccessBranch(request.resource.data.branchId));
      allow delete: if isSuperAdmin() || isAdmin() ||
        (isBranchManager() && canAccessBranch(resource.data.branchId));
    }

    match /tv_health/{healthId} {
      allow read: if isActiveUser();
      // Unauthenticated heartbeat from the TV; low-sensitivity ping data. Kept
      // open so a TV with no login can report health; delete is admin-only.
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || isAdmin() ||
        (isBranchManager() && resource.data.branchId == managerBranchId());
      allow create: if isActiveUser();
      allow update: if false;
      // Admins can remove error-prone / mistaken log rows (client request 2026-07-14).
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isActiveUser();
      allow create: if isSuperAdmin();
      allow update: if isActiveUser();
      allow delete: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if isActiveUser();
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    // Upload-access lock (video/image upload password + granted admins). ONLY the
    // client owner (admin@unimoni-signage.com) — or the developer super admin —
    // may CHANGE it. Any signed-in admin may READ it, so the app can tell whether
    // the lock is on and show the right screen; the app itself only reveals the
    // password to the owner and granted admins. This is a NEW collection: it does
    // not touch the videos / image_adverts rules, so existing uploads are
    // completely unaffected.
    match /app_config/{configId} {
      function isUploadOwner() {
        return isActiveUser()
          && request.auth.token.email != null
          && request.auth.token.email.lower() == 'admin@unimoni-signage.com';
      }
      // Readable by any signed-in user: the dashboard theme needs it, and branch
      // staff with the media chip must read the upload-lock status to know
      // whether an upload needs the password. (The upload password itself lives
      // here in plaintext — a known limitation flagged for a follow-up: hash it
      // or split the secret from the on/off status. It is NOT public — only
      // authenticated active users can read it.)
      allow read: if isActiveUser();
      // The org-wide dashboard THEME doc is editable by any admin; the upload
      // lock and other config docs stay owner/super-admin only.
      allow create, update: if isSuperAdmin() || isUploadOwner()
        || (isAdmin() && configId == 'theme');
      allow delete: if false;
    }

    match /roles/{roleId} {
      allow read: if isActiveUser();
      allow write: if isSuperAdmin();
    }

    match /permissions/{permissionId} {
      allow read: if isActiveUser();
      allow write: if isSuperAdmin();
    }

    match /activity_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isActiveUser();
      allow update, delete: if false;
    }

    match /scheduled_content/{contentId} {
      allow read: if isActiveUser();
      allow create: if canManageBranchContent(request.resource.data.branchId);
      allow update: if canManageBranchContent(resource.data.branchId) &&
        canManageBranchContent(request.resource.data.branchId);
      allow delete: if isSuperAdmin() ||
        canManageBranchContent(resource.data.branchId);
    }

    match /pending_approvals/{approvalId} {
      allow read: if isSuperAdmin() || isAdmin() ||
        (isBranchManager() && resource.data.branchId == managerBranchId());
      allow create: if isActiveUser() &&
        request.resource.data.branchId is string &&
        canManageBranchRates(request.resource.data.branchId);
      allow update: if isSuperAdmin() || isAdmin() ||
        (isBranchManager() && resource.data.branchId == managerBranchId());
      allow delete: if isSuperAdmin();
    }
  }
}
